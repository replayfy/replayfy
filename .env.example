# Replayfy self-host configuration. Copy to `.env` and adjust.
# Everything here has a working local default in docker-compose.yml, so an
# untouched `docker compose up` runs — but CHANGE the secrets before exposing it.

# ── Security (REQUIRED) ─────────────────────────────────────────────────────
# The API refuses to start if unset or shorter than 16 chars. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production-please-32chars

# ── Ports (host side) ───────────────────────────────────────────────────────
DASHBOARD_PORT=8080
API_PORT=4000
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025

# ── Public URLs (as the browser reaches them) ───────────────────────────────
# For a remote host, replace localhost with your domain (and put HTTPS in front).
APP_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8080
TRUST_PROXY=1

# ── Datastore credentials (used to build the connection strings) ────────────
POSTGRES_USER=replay
POSTGRES_PASSWORD=replay
POSTGRES_DB=replay_platform
MONGO_DB=replay
CLICKHOUSE_DATABASE=replay

# ── Object storage (MinIO by default; any S3-compatible store works) ─────────
S3_ACCESS_KEY_ID=replayfy
S3_SECRET_ACCESS_KEY=replayfy-secret
S3_BUCKET=replayfy
S3_REGION=us-east-1
# Browser-reachable read URL (must include the bucket for path-style MinIO).
S3_PUBLIC_BASE_URL=http://localhost:9002/replayfy

# ── Demo data ────────────────────────────────────────────────────────────────
# 1 = seed a demo workspace + login (admin@local / admin) on first boot.
SEED_DEMO=1

# ── Email ────────────────────────────────────────────────────────────────────
# Default routes mail to the built-in Mailpit catcher (read it at :8025).
# For real delivery set EMAIL_PROVIDER=smtp with your relay, or =resend.
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=Replayfy <hello@localhost>
# RESEND_API_KEY=

# ── AI (optional) ─────────────────────────────────────────────────────────────
# Set a provider + key + model to turn on Storylines / signals / investigations.
# Self-host AI is UNMETERED — you pay your provider directly.
#   LLM_PROVIDER=openrouter   (or leave blank for Anthropic-direct)
#   OPENROUTER_API_KEY=sk-or-...     ANTHROPIC_API_KEY=sk-ant-...
#   LLM_MODEL=anthropic/claude-3.5-sonnet   (a fully-qualified model id)
LLM_PROVIDER=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# ── Stripe (leave blank — billing is Enterprise-only, not in this build) ─────
VITE_STRIPE_PUBLISHABLE_KEY=
