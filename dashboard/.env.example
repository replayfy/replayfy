# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed vars to the
# client, and they are BAKED IN AT BUILD TIME — changing one in the deploy
# environment does nothing until you rebuild. Never put a secret here; every
# value in this file ships to the browser.

# Base URL of the ingest API, no trailing slash.
# In DEV it falls back to http://127.0.0.1:4000 (the value below). A PRODUCTION
# build (`vite build`) now THROWS at load if this is unset, instead of silently
# baking in localhost — so CI must inject VITE_API_URL=https://<prod-api> (e.g.
# https://us.replayfy.app) at build time. Verify after building:
#   grep -r 127.0.0.1 dist/assets   # must return nothing
VITE_API_URL=http://127.0.0.1:4000

# Stripe PUBLISHABLE key (pk_test_… / pk_live_…) — safe to expose; this is the
# client half of STRIPE_SECRET_KEY on the API and must come from the SAME
# Stripe account and the same mode (both test or both live, or checkout fails
# to mount). Without it getStripe() resolves null and stripeConfigured is
# false: embedded checkout and credit top-ups quietly decline to open, so
# nobody can pay. The rest of the dashboard works normally.
VITE_STRIPE_PUBLISHABLE_KEY=
