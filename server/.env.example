DATABASE_URL_POSTGRES=postgresql://replay:replay@127.0.0.1:5433/replay_platform?schema=public
DATABASE_URL_MONGO=mongodb://localhost:27017/replay?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6380
# ── Email ────────────────────────────────────────────────────────────
# EMAIL_PROVIDER selects the transport: resend | smtp | console. Unset infers it
# — resend if RESEND_API_KEY is set, smtp if SMTP_HOST is set, else console
# (log-only: search the API logs for "[dev-email]", nothing is delivered). The
# console default means local dev / self-host runs with no email account.
EMAIL_PROVIDER=
# From header (display name + address). Falls back to Replayfy <hello@$EMAIL_DOMAIN>.
EMAIL_DOMAIN=email.replayfy.app
# EMAIL_FROM=Replayfy <hello@email.replayfy.app>
# Resend (hosted email API) — the From domain must be verified in Resend.
RESEND_API_KEY=
# SMTP relay (used when EMAIL_PROVIDER=smtp). SMTP_SECURE=true for implicit TLS (465).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
APP_BASE_URL=http://127.0.0.1:5180
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
PORT=4000

# ── Overview AI (optional) ───────────────────────────────────────────────
# 32-byte (64 hex chars) key that encrypts workspace BYOK LLM keys at rest.
# Required only if any workspace uses BYOK. Generate: openssl rand -hex 32
LLM_KMS_KEY=
# Managed platform key used when a workspace's LLM mode is PLATFORM (the
# default). Without it, PLATFORM workspaces resolve to no provider (the
# Overview still works template-only). ANTHROPIC_API_KEY is accepted as a fallback.
LLM_PLATFORM_KEY=
# Provider model id for AI calls (OpenRouter slug, e.g. anthropic/claude-sonnet-4).
# It has NO default: if AI is enabled but this is unset, every AI call goes out
# with no model and the provider 400s. Required whenever AI features are on.
LLM_MODEL=
# Optional cheaper/faster model for guard + selector passes; falls back to LLM_MODEL.
LLM_MODEL_FAST=
# Optional cheaper model for the grounded intel pass; falls back to LLM_MODEL.
LLM_MODEL_INTEL=
# Provider selector: "openrouter" routes via OpenRouter (LLM_MODEL needs a vendor
# prefix); anything else = Anthropic direct (bare model id).
LLM_PROVIDER=
# Provider key for PLATFORM mode: the OpenRouter path uses OPENROUTER_API_KEY,
# Anthropic-direct uses ANTHROPIC_API_KEY (LLM_PLATFORM_KEY is a fallback for both).
# On a self-host (no Enterprise billing) AI is UNMETERED — set a key + LLM_MODEL
# and it just works; nothing is credit-gated.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ── Mobile screenshot capture ───────────────────────────────────────
# Capture rate/quality is resolved from the workspace plan (see
# billing/plan-catalog.ts, PLAN_TIERS.mobileMax*), with a per-workspace override
# in Settings → Recording. On a self-host there is no billing, so every
# workspace resolves to the unlimited tier — you get the system maximum, not a
# 1 fps floor. (The metered cloud is where those tier ceilings actually bite.)
# The old MOBILE_FPS / MOBILE_QUALITY env knobs are gone; set the rate per
# workspace in Settings → Recording.

# ── Object storage (S3-compatible) ──────────────────────────────────
# Stores session assets, thumbnails, and media. Any S3-compatible store works —
# MinIO (the docker-compose default), AWS S3, Cloudflare R2, Backblaze B2, …
# Leave empty in local dev and StorageService runs in disabled mode (the
# dashboard's rrweb-rebuild thumbnail path still works).
# S3_FORCE_PATH_STYLE=true for MinIO; S3_PUBLIC_BASE_URL is the browser-reachable
# read URL — path-style includes the bucket (e.g. http://localhost:9002/replayfy).
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_BASE_URL=
#
# Cloudflare R2 shortcut: set these instead and the S3 endpoint is derived from
# the account id. Plain S3_* above take precedence if both are set.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# ── Dashboard URL ────────────────────────────────────────────────────
# Public origin of the dashboard, no trailing slash. Used for OAuth callbacks
# and deep links in notifications and integration payloads.
# THERE IS A LOCALHOST FALLBACK — a deploy that forgets this sends users back to
# 127.0.0.1. Leave BLANK unless you actually need to override it: the
# integrations OAuth callbacks fall back to :5180 (matching APP_BASE_URL above),
# and SETTING this suppresses that fallback, so a value copied blindly from here
# can move every OAuth callback to the wrong port and break connect flows that
# work today. In production set it to your real dashboard origin, once.
DASHBOARD_URL=
# Public origin of the DASHBOARD, used by the OAuth (social-login) success/error
# redirect. Falls back to http://127.0.0.1:5180. In prod set to the dashboard origin
# (usually the same value as DASHBOARD_URL, e.g. https://app.replayfy.app).
APP_BASE_URL=
# Public origin of THIS API, used to build the OAuth provider callback URL
# (…/v1/auth/oauth/:provider/callback). Falls back to http://127.0.0.1:4000. In
# prod set to the API's public origin (e.g. https://us.replayfy.app) and register
# that exact callback URL with each OAuth provider.
API_BASE_URL=

# REQUIRED: session-token signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The app fail-closes (refuses to start) if this is unset or <16 chars.
JWT_SECRET=
# Optional: dedicated mobile-ingest signing key (falls back to JWT_SECRET).
MOBILE_INGEST_SECRET=

# Security hardening:
# CORS allowlist (comma-separated). Unset = reflect any origin (dev only) and
# the app logs a loud boot warning. REQUIRED in prod — set to the exact
# dashboard origin(s), e.g. https://app.replayfy.app
CORS_ORIGINS=
# Reverse-proxy / load-balancer trust. Unset = off (local/direct dev). Behind an
# LB set to the number of proxy hops (usually 1) so req.ip is the real client —
# WITHOUT this the rate limiter buckets every client together (one actor can
# 429-lock all logins) and geoip resolves to the LB. Do NOT set to `true` if the
# app is directly internet-reachable (clients could spoof X-Forwarded-For).
TRUST_PROXY=
# ClickHouse per-query resource caps (server-side; prevent query-abuse OOM).
CLICKHOUSE_MAX_EXECUTION_TIME=60
CLICKHOUSE_MAX_MEMORY_USAGE=4000000000
CLICKHOUSE_MAX_ROWS_TO_READ=2000000000
CLICKHOUSE_MAX_RESULT_ROWS=5000000
# HTTP rate limit (global; auth routes are stricter, ingest is exempt).
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=1000
# Prisma query logging. Leave UNSET in prod — PRISMA_LOG=1 writes full SQL
# (including parameter values / PII) to the logs. Default logs only warn+error.
PRISMA_LOG=

# Health probes (no env needed): GET /healthz = liveness (process only),
# GET /readyz = readiness (pings Postgres/Redis/ClickHouse/Mongo, 503 until all
# up). Point your load balancer at these — see DEPLOYMENT.md.
